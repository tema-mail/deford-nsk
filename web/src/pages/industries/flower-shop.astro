---
// Нишевая страница «Сайт для цветочного магазина» – дизайн по прототипу v2
// (sayty-agent/prototipy/deford/industry-cvety-v2.html, оффер владельца 04.11.2026). Порядок блоков – цепочка вопросов прототипа.
// Чего нет в подтверждённых данных – не ставим (слово Артёма 11.11.2026): таблица спроса без чисел, замер нагрузки, срок ответа.
import Site from '../../layouts/Site.astro';
import VideoReviews from '../../components/VideoReviews.astro';
import Hero from '../../components/Hero.astro';
import { C, B, P } from '../../data/contacts';

const img = (n: string) => `${B}img/${n}.webp`;
const starts = [
  ['Продаёте в группе ВК или на Авито', 'Заказы живут в переписке, базы покупателей нет. Собираем магазин, а заказы приходят туда, где вы уже привыкли работать.'],
  ['Сайт есть, но это один каталог', 'Нет главной, у букетов нет описаний, бонусы обещаны, а копить негде. Переносим каталог на код и достраиваем всё, что продаёт.'],
  ['Заказы идут через агрегатор', 'Покупатель остаётся у площадки, и каждый новый заказ вы оплачиваете снова. Делаем свой канал и свою базу, чтобы второй заказ приходил к вам.'],
  ['К датам заказов меньше, чем могло быть', 'К 8 марта и 1 сентября покупатели ищут готовое, а страниц под даты нет. Ставим подборки заранее, а на старте даём рекламу.'],
];
const occasions = ['Цветы с доставкой', 'Букет на 8 марта', 'Цветы на 1 сентября', 'День матери', '14 февраля', 'Свадебная флористика', 'Букет на день рождения', 'Выпускной'];
const shop = [
  ['M4 5h16M7 12h10M10 19h4', 'Каталог с фильтрами', 'По поводу, цвету, цене и составу. На телефоне две карточки в ряд: букет видно сразу.'],
  ['M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z', 'Карточка букета', 'Состав по стеблям и высота, фото именно вашей сборки и что заменим, если цветка не осталось. Так не звонят, а заказывают.'],
  ['M4 7h16v12H4zM8 3v4m8-4v4M4 11h16', 'Подборки по поводам', '8 марта, День матери, выпускной, свадьба, извинения. Ответ тому, кто не знает, что выбрать, и страницы под спрос.'],
  ['M3 7h11v9H3zm11 3h4l3 3v3h-7zM7 19a2 2 0 100-4 2 2 0 000 4zm10 0a2 2 0 100-4 2 2 0 000 4z', 'Доставка по дате', 'Дата и интервал в корзине, цена по районам и по сумме заказа. Яндекс Доставка, своя доставка и самовывоз.'],
  ['M3 6h18v12H3zM3 10h18', 'Оформление и оплата', 'Эквайринг любого банка и оплата частями: Долями, Сплит, Подели. Открытка, анонимная доставка, получатель отдельно.'],
  ['M4 12a8 8 0 0113.7-5.7L20 9M20 4v5h-5M20 12a8 8 0 01-13.7 5.7L4 15m0 5v-5h5', 'Кабинет и повторный заказ', 'Прошлый букет и адрес в два касания, свои даты и бонусы: второй заказ уже не надо оплачивать рекламой.'],
];
const ads = [
  ['61363837-3', 'Реклама ВКонтакте', 'Обращение – 251 ₽ вместо 2 500–3 000 ₽', '209 тёплых обращений: реклама по району, чат-бот, рассылка, ретаргетинг.', 'https://vc.ru/id3572167/3150153-effektivnaya-reklama-tsvetochnogo-magazina-vkontakte'],
  ['35613666-2', 'Без сайта, только ВКонтакте', '215 обращений по 245 ₽', 'Сайта у магазина не было – две связки с чат-ботом во ВКонтакте.', 'https://vc.ru/id3572167/3150182-kak-privelch-klientov-v-tsvetochnyj-magazin-cherez-vkontakte'],
  ['63336436-1', 'Перенастройка рекламы', 'Заявка – 400 ₽ вместо 1 500–2 000 ₽', 'Разобрали группу, настроили чат-бота и воронку, протестировали аудитории.', 'https://vc.ru/marketing/3150040-reklama-vkontakte-dlya-tsvetochnogo-magazina'],
];
// Живые магазины – те же, что в кейсах Target Factory (tf-flowers/ShopCases): названия и города сняты с сайтов магазинов
const shops = [
  ['shop-milovini', 'Milovini Flowers', 'Самара', 'https://milovinisamara.ru/'],
  ['shop-compliment', 'Compliment', 'Брянск', 'https://compliment-32.ru/'],
  ['shop-holiflori', 'HoliFlori', 'Сергиев Посад', 'https://holiflori.ru/'],
];
const tiers = [
  ['Базовый', '70 000', 'Каталог с фильтрами, карточки, корзина, доставка по дате, заказы и админка.', false],
  ['Оптимальный', '90 000', 'Плюс страницы поводов, доставки и о магазине, настройка рекламы, Метрика с целями.', true],
  ['Расширенный', '150 000', 'Плюс личный кабинет покупателя, бонусы и повторный заказ.', false],
];
---
<Site title="Сайт для цветочного магазина – интернет-магазин, который продаёт | Дефорд" description="Делаем интернет-магазины для цветочных: каталог, доставка по дате, оплата частями, кабинет и повторный заказ. Заказы с первого дня запуска. Можно начать от 35 000 ₽.">
  <a slot="cta" class="btn" href="#form">Показать спрос</a>
  <span slot="sheet-cta">Показать спрос в моём городе</span>


  <!-- 1. Первый экран: оффер владельца, четыре варианта подачи на выбор (переключатель внизу экрана) -->
  <Hero eyebrow="Сайты для цветочных магазинов" title='Делаем сайты, которые <span class="b">продают цветы</span>'
    lead="А не просто витрины, которые висят в интернете. Продажи – с первого дня запуска интернет-магазина."
    hint="Пришлём таблицу: что ищут в вашем городе и сколько раз в месяц. Без звонка."
    wide={img('gen/flowers-hero')} tall={img('gen/flowers-portrait')} alt="Флорист собирает букет в цветочном магазине">
    <Fragment slot="btns">
      <a class="btn" href="#form">Показать спрос в вашем городе</a>
      <a class="btn alt" href={C.tg} target="_blank" rel="noopener">Написать в Telegram</a>
    </Fragment>
    <Fragment slot="side">
      <div class="hx-card"><small>Сделали</small><b>больше 10 сайтов</b><span>для цветочных магазинов</span></div>
      <div class="hx-card"><small>Можно начать</small><b>от 35 000 ₽</b><span>остальное частями</span></div>
      <div class="hx-card"><small>Реклама</small><b>в день запуска</b><span>заказы идут сразу</span></div>
    </Fragment>
    <div slot="visual" class="phones" aria-label="Каталог и карточка букета в нашем цветочном магазине на телефоне">
      <div class="phone ph1"><img src={img('milovini-catalog-m')} alt="Каталог Milovini Flowers на телефоне: две карточки букетов в ряд" width="780" height="1688" loading="lazy"></div>
      <div class="phone ph2"><img src={img('milovini-product-m')} alt="Карточка букета в магазине Milovini Flowers на телефоне" width="780" height="1688" loading="lazy"></div>
    </div>
  </Hero>

  <!-- 2. Ситуации: человек узнаёт себя -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head rv"><h2 class="h2">С чего вы стартуете – <span class="m">с того и начнём</span></h2></div>
      <div class="grid on-bg" style="--c:4">
        {starts.map(([t, d], i) => (
          <article class={`card rv${i === 0 ? ' dark' : ''}`} style={`--d:${i * .06}s`}>
            <span class="num">0{i + 1}</span>
            <h3 class="h3">{t}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Спрос по поводам: чисел по городу клиента нет – вместо пустой таблицы предлагаем снять её бесплатно -->
  <section class="sheet">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <h2 class="h2">Люди ищут цветы <span class="m">к поводу. Есть ли у вас такая страница?</span></h2>
          <p class="lead">Каждый повод – отдельный запрос в поиске. Нет страницы под повод – покупатель ищет ваш букет и не доходит до вас. Спрос скачет по датам, поэтому страницу под 8 марта ставим в январе, а не 7 марта вечером.</p>
        </div>
        <a class="btn" href="#form">Прислать таблицу спроса</a>
      </div>
      <figure class="occ rv">
        <img src={img('gen/flowers-wide')} alt="Флорист передаёт букет курьеру у двери цветочного магазина" width="1672" height="941" loading="lazy">
        <figcaption>
          <h3 class="h3">Поводы, под которые нужны свои страницы</h3>
          <div class="chips">{occasions.map((o, i) => <span class="chip"><b>{String(i + 1).padStart(2, '0')}</b>{o}</span>)}</div>
        </figcaption>
      </figure>
      <p class="note rv">Спрос по вашему городу и по датам снимем бесплатно – до любого разговора о магазине.</p>
    </div>
  </section>

  <!-- 4. Магазин: шесть узлов, которые видит покупатель, рядом – живой каталог -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head rv"><h2 class="h2">Сайт, который работает <span class="b">как второй магазин</span></h2></div>
      <div class="shop">
        <div class="shop-panel">
          {shop.map(([d, t, p], i) => (
            <article class="card rv" style={`--d:${(i % 2) * .06}s`}>
              <div class="card-top"><h3 class="h3">{t}</h3><span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
              <p>{p}</p>
            </article>
          ))}
        </div>
        <figure class="shop-shot rv">
          <img class="ss-desk" src={img('milovini-home')} alt="Главная интернет-магазина Milovini Flowers, Самара" width="1600" height="1000" loading="lazy" data-zoom={img('milovini-home')} data-alt="Milovini Flowers – главная">
          <div class="phone ss-phone"><img src={img('milovini-catalog-m')} alt="Каталог Milovini Flowers на телефоне" width="780" height="1600" loading="lazy"></div>
          <figcaption><b>Milovini Flowers, Самара</b><span>Интернет-магазин на нашем коде</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 5. Магазин ваш: ответ на «чьё всё, если уйду» -->
  <section class="sheet">
    <div class="wrap">
      <div class="sec-head rv"><h2 class="h2">Магазин ваш, <span class="m">и вести его можете сами</span></h2></div>
      <div class="grid" style="--c:3">
        <article class="card blue rv"><h3 class="h3">Это не подписка</h3><p>Домен, заявки, аналитика, тексты и фото ваши с первого дня. После последнего платежа сайт полностью ваш.</p></article>
        <article class="card rv" style="--d:.06s"><h3 class="h3">Букеты и цены без программиста</h3><p>Сами меняете цену, фото, состав и наличие, ставите метки, загружаете таблицей. Заявки на доске: новые, в работе, выполнены, откуда пришёл покупатель.</p></article>
        <article class="card rv" style="--d:.12s"><h3 class="h3">Переезд без потерь</h3><p>Каталог, фото и адреса переносим сами, со старых страниц ставим 301. Цветочный магазин в Самаре так переехал с конструктора: 255 карточек товаров.</p></article>
      </div>
      <p class="note rv">Накануне 8 марта случайно удалить букет нельзя: удаление только внутри записи и через архив.</p>
    </div>
  </section>

  <!-- 6. Заказы сразу: реклама в день запуска, доказательства – кейсы трафика именно цветочных -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <h2 class="h2">Сайт, который <span class="b">начинает продавать сразу</span></h2>
          <p class="lead">Поиску нужно время: первые позиции – это месяцы. Поэтому мы не сажаем вас ждать. В день запуска включаем рекламу, и заказы идут сразу, пока поиск раскачивается. Через несколько месяцев поиск забирает часть трафика на себя, и реклама становится дешевле.</p>
        </div>
      </div>
      <div class="grid on-bg" style="--c:3">
        <article class="card rv"><span class="num">01</span><h3 class="h3">Яндекс Бизнес</h3><p>Карточка в Картах и Поиске: звонки, маршрут, витрина букетов. Самый быстрый канал для магазина с адресом.</p></article>
        <article class="card rv" style="--d:.06s"><span class="num">02</span><h3 class="h3">Яндекс Директ</h3><p>Объявления по запросам «доставка цветов» и «букет на день рождения» в вашем городе. Включается в день запуска.</p></article>
        <article class="card rv" style="--d:.12s"><span class="num">03</span><h3 class="h3">Всё вместе к дате</h3><p>Нужен поток к 8 марта или 1 сентября – ставим и Бизнес, и Директ, и отдельные страницы заранее.</p></article>
      </div>
      <h3 class="h3 ads-h rv">Реклама цветочных магазинов – <span class="b">цифры из кабинетов</span></h3>
      <div class="grid on-bg" style="--c:3">
        {ads.map(([im, k, t, p, u], i) => (
          <article class="card ad rv" style={`--d:${i * .06}s`}>
            <figure class="shot ad-shot" data-zoom={img(im)} data-alt={t}><img src={img(im)} alt={`Кабинет рекламы: ${t}`} width="1270" height="640" loading="lazy"></figure>
            <small class="kick">{k}</small>
            <h3 class="h3">{t}</h3>
            <p>{p}</p>
            <a class="link" href={u} target="_blank" rel="noopener">Разбор кейса на vc.ru →</a>
          </article>
        ))}
      </div>
      <p class="small src rv">Кейсы команды трафика Target Factory, с которой мы запускаем рекламу цветочных магазинов.</p>
      <div class="btns rv" style="margin-top:24px"><a class="btn" href="#form">Посчитать бюджет на старт</a></div>
    </div>
  </section>

  <!-- 7. Работы: живые магазины крупно, снимки открываются окном -->
  <section class="sheet" id="cases">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <h2 class="h2">Больше десяти сайтов <span class="m">для цветочных магазинов</span></h2>
          <p class="lead">Поэтому мы спорим с вами о составе карточки букета и о датах сезона, а не узнаём нишу по ходу проекта.</p>
        </div>
      </div>
      <div class="cases">
        {shops.map(([im, name, city, url], i) => (
          <article class="case rv" style={`--d:${i * .08}s`}>
            <figure class="shot case-shot" data-zoom={img(im)} data-alt={`${name}, ${city}`}><img src={img(im)} alt={`Интернет-магазин цветов ${name}, ${city}`} width="1440" height="820" loading="lazy"></figure>
            <a class="case-txt" href={url} target="_blank" rel="noopener" aria-label={`Перейти на сайт ${name}`}><span><small class="kick">Интернет-магазин цветов · {city}</small><b class="h3">{name}</b></span><i class="go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></i></a>
          </article>
        ))}
      </div>
      <div class="grid stories" style="--c:2">
        <article class="card rv"><h3 class="h3">Перенос с конструктора на свой код</h3><p>Цветочный магазин в Самаре: перенесли с конструктора, добавили кабинет владельца. Новый цветочный собираем по этому эталону, а не с нуля.</p></article>
        <article class="card rv" style="--d:.08s"><h3 class="h3">Магазин, который продавал только через ВК</h3><p>Новосибирск: сайта не было вообще. Собрали магазин с каталогом, заказы уходят в ВК, как продавец уже привык.</p></article>
      </div>
      <div class="card show rv">
        <h3 class="h3">Покажем эталонный цветочный магазин живьём и разберём ваш каталог</h3>
        <a class="btn" href="#form">Записаться на показ</a>
      </div>
    </div>
  </section>

  <!-- 8. Цена: сборки, рассрочка, что платите потом -->
  <section class="sec" id="prices">
    <div class="wrap">
      <div class="sec-head rv"><h2 class="h2">Сколько стоит цветочный магазин, <span class="m">и что вы платите потом</span></h2></div>
      <div class="grid on-bg tiers" style="--c:3">
        {tiers.map(([n, p, d, hit], i) => (
          <article class={`card tier rv${hit ? ' hit' : ''}`} style={`--d:${i * .06}s`}>
            <h3 class="h3">{n}</h3>
            <div class="price">{p} <span>₽</span></div>
            <p>{d}</p>
          </article>
        ))}
      </div>
      <div class="pay on-bg">
        <div class="card start rv">
          <small class="kick">Рассрочка без банка</small>
          <h3 class="start-n">от 35 000 ₽</h3>
          <p>Можно начать с этой суммы. Дальше 10 000–15 000 ₽ в месяц без процентов и банка, поддержка уже внутри платежа.</p>
          <a class="btn" href="/sayty-agent/prototipy/deford/installment.html">Как работает рассрочка</a>
        </div>
        <div class="card rv" style="--d:.08s">
          <h3 class="h3">Что платите потом</h3>
          <table class="tbl">
            <thead><tr><th>Что</th><th>Сколько</th><th>Кому</th></tr></thead>
            <tbody>
              <tr><td>Домен и сервер</td><td>по тарифу</td><td>не нам</td></tr>
              <tr><td>Бюджет рекламы</td><td>считаем на старте, держите сами</td><td>Яндексу</td></tr>
              <tr><td>Ведение и подготовка к датам</td><td>10 000 ₽ в месяц, по желанию</td><td>нам</td></tr>
            </tbody>
          </table>
          <p class="small">От чего зависит цена: сколько букетов и поводов, нужен ли кабинет с бонусами, отдельный опт, какие службы доставки подключаем.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Кто делает и что после запуска -->
  <section class="sheet">
    <div class="wrap who">
      <figure class="who-ph rv"><img src={img('artem-ava')} alt="Артём Галимов, основатель Дефорда" width="900" height="900" loading="lazy"></figure>
      <div class="who-txt">
        <h2 class="h2 rv">Кто делает ваш магазин <span class="m">и кто готовит его к 8 марта</span></h2>
        <div class="who-card card rv">
          <b class="who-name">Артём Галимов, основатель Дефорда</b>
          <p>15 лет в маркетинге, сайты делаю с 2015 года. Разговариваете вы со мной: я снимаю спрос, раскладываю каталог и отвечаю за результат. Если спроса на ваши букеты в городе мало, скажу это сразу и магазин продавать не буду.</p>
        </div>
        <div class="who-card card rv">
          <b class="who-name">После запуска</b>
          <p>Добавляем страницы под спрос и заранее готовим даты: под 8 марта – в январе, под 1 сентября – в июле. Смотрим, откуда приходят заказы, и правим то, что не приносит.</p>
          <a class="link" href={`${P}services/seo/`}>Что входит в ведение →</a>
        </div>
      </div>
    </div>
  </section>

  <VideoReviews count={8} />

